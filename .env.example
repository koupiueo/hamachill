# ===== hamachill server settings / サーバー設定 =====
# Copy to .env and fill in. Never commit .env.
# .env にコピーして値を入れる（.env は git に入れない）

# --- Required / 必須 ---
# JWT signing key, 32+ random characters / JWT の署名鍵（32 文字以上のランダム文字列）
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server / サーバー ---
HOST=0.0.0.0
PORT=3000
# Where the SQLite DB, uploads, soundboards and stamps live (default: server/). Docker uses /data.
# DB・アップロード・サウンドボード・スタンプの保存先（既定は server/。Docker では /data）
DATA_DIR=

# --- Origins / 公開 URL ---
# Public URL the app is served from, e.g. https://chat.example.com (CORS + Vite dev allowedHosts)
# 公開 URL（例: https://chat.example.com）。localhost は常に許可
PUBLIC_ORIGIN=
# Extra allowed origins, comma separated (e.g. LAN dev) / 追加で許可する Origin（カンマ区切り）
EXTRA_ORIGINS=

# Set to 1 behind a reverse proxy (nginx etc.); leave empty when exposed directly.
# リバースプロキシ（nginx など）の後ろなら 1。直接公開なら空のまま（IP 偽装でレート制限を抜けられないように）
TRUST_PROXY=
# Set to 1 only when served solely through Cloudflare Tunnel (trusts CF-Connecting-IP).
# Cloudflare Tunnel 経由だけで公開するなら 1（CF-Connecting-IP を信じる）
TRUST_CLOUDFLARE=

# --- Limits / 上限 ---
# Max attachment size in MB (default 95, fits Cloudflare's 100MB free-plan limit)
# 添付ファイルの上限 MB（既定 95。Cloudflare 無料プランの 100MB に収まる）
MAX_UPLOAD_MB=
# Auth requests per IP per minute (default 5) / IP ごとの認証リクエスト数／分（既定 5）
AUTH_RATE_LIMIT=
# Login attempts per account per 15 minutes (default 10) / アカウントごとのログイン試行／15 分（既定 10）
LOGIN_RATE_LIMIT=

# --- Admins / 管理者 ---
# Account IDs with admin rights, comma separated. Empty = the first account created is admin.
# 管理者のアカウント ID（カンマ区切り）。空なら最初に作られたアカウントが管理者
ADMIN_IDS=

# --- Voice chat / 通話 (WebRTC) ---
# ICE servers for voice/screen share. JSON or comma-separated URLs. Empty = LAN only.
# 通話用の ICE サーバー。JSON かカンマ区切りの URL。空なら同じ LAN 内でだけ通話できる
#   ICE_SERVERS=stun:stun.example.com:3478
#   ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=

# --- Optional: GIF search (KLIPY) / 任意: GIF 検索 ---
# Empty = GIF tab is hidden / 空なら GIF タブを出さない
KLIPY_API=

# --- Optional / 任意 ---
# Verbose logs / 詳しいログを出す
# DEBUG=1
